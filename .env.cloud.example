# Cloud MySQL setup (Aiven free plan) - copy to .env.cloud (git-ignored), then:
#   backend\.venv\Scripts\python.exe -I local\setup_db.py --env-file .env.cloud
# Paste the Aiven "Service URI" (Aiven console -> your MySQL service -> Overview).
MYSQL_URI=mysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl-mode=REQUIRED
# Users the script creates; put MYSQL_APP_PASSWORD into Render as well. No single quotes.
MYSQL_APP_USER=attendance_app
MYSQL_APP_PASSWORD=change_me_app_pw
MYSQL_ADMIN_USER=attendance_admin
MYSQL_ADMIN_PASSWORD=change_me_admin_pw
MYSQL_REPORT_USER=attendance_report
MYSQL_REPORT_PASSWORD=change_me_report_pw
