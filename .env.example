# =====================================================================
#  Smart Face Recognition Attendance System - environment template
#  cp .env.example .env      (then change every "change_me" value)
#  Passwords: avoid single quotes (they are embedded in SQL by init scripts)
# =====================================================================

# ---------- general ----------
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public URL of the frontend (used inside QR codes and e-mails)
FRONTEND_URL=http://localhost:3000

# ---------- MySQL (ACID system of record) ----------
MYSQL_ROOT_PASSWORD=change_me_root_pw
MYSQL_APP_USER=attendance_app
MYSQL_APP_PASSWORD=change_me_app_pw
MYSQL_ADMIN_USER=attendance_admin
MYSQL_ADMIN_PASSWORD=change_me_admin_pw
MYSQL_REPORT_USER=attendance_report
MYSQL_REPORT_PASSWORD=change_me_report_pw

# ---------- MongoDB (embeddings, logs, snapshots) ----------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_mongo_root_pw
MONGO_APP_USER=attendance_app
MONGO_APP_PASSWORD=change_me_mongo_app_pw

# ---------- security ----------
# Leave JWT_SECRET / EMBEDDING_ENC_KEY empty to auto-generate them on first boot
# (persisted in the backend_data volume). To set explicitly:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# EMBEDDING_ENC_KEY accepts a comma-separated list for key rotation (first = active).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
EMBEDDING_ENC_KEY=
BCRYPT_ROUNDS=12

# First admin account (created on first boot if missing)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change_me_Admin1
# Password given to the seeded demo teachers/students (leave empty to keep them disabled)
DEMO_USER_PASSWORD=change_me_Demo1

# ---------- face engine ----------
# auto | insightface | face_recognition | opencv
FACE_ENGINE=auto
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
# Cosine-similarity thresholds. Empty = engine default (0.45 / 0.60 for ArcFace)
MATCH_THRESHOLD=0.45
DUPLICATE_THRESHOLD=
LOW_CONF_MARGIN=0.08
AUTO_REENROLL=true
MAX_EMBEDDINGS_PER_STUDENT=15
MIN_REG_PHOTOS=5
MAX_REG_PHOTOS=10
BLUR_THRESHOLD=30
MIN_FACE_PX=80
# auto | numpy | faiss
VECTOR_BACKEND=auto

# ---------- liveness / anti-spoofing ----------
LIVENESS_REQUIRED=true
LIVENESS_MIN_YAW_DELTA=15
MOIRE_THRESHOLD=3.2

# ---------- attendance rules ----------
SHORTAGE_THRESHOLD=75
SESSION_WINDOW_ENFORCED=true
AUTO_CLOSE_GRACE_MIN=15
QR_WINDOW_SECONDS=30

# ---------- data retention (MongoDB TTL indexes) ----------
RECOGNITION_LOG_TTL_DAYS=90
SNAPSHOT_TTL_DAYS=30

# ---------- e-mail (defaults to the bundled Mailpit catcher) ----------
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Smart Attendance <no-reply@example.org>
SMTP_STARTTLS=false
SMTP_SSL=false

# ---------- background jobs ----------
SCHEDULER_ENABLED=true
DAILY_SUMMARY_HOUR=18
SHORTAGE_ALERT_DAY=mon
SHORTAGE_ALERT_HOUR=9

# ---------- docker build ----------
# Download InsightFace buffalo_l (~280 MB) at build time
PRELOAD_MODELS=true
# Also compile dlib + face_recognition fallback (slow, ~10 min)
INSTALL_DLIB=false

# ---------- host ports ----------
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
MYSQL_HOST_PORT=3307
MONGO_HOST_PORT=27018
MAILPIT_UI_PORT=8025
